{
  "name": "tavern-slot-framework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --experimental-strip-types server.js\" \"vite --host 0.0.0.0\"",
    "start": "node --experimental-strip-types server.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.120",
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
