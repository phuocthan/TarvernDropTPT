{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Framework Game Config v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "reels",
    "rows",
    "lines",
    "symbols",
    "bets",
    "initialBoard",
    "routing",
    "presentation",
    "demo",
    "defaultBet"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reels": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "bets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "initialBoard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "query",
        "apiBase",
        "skin"
      ],
      "properties": {
        "query": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "apiBase": {
          "type": "string",
          "pattern": "^/api(?:/[a-z][a-z0-9-]*)?$"
        },
        "skin": {
          "enum": [
            "basic",
            "tavern"
          ]
        }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": [
        "spinType",
        "cellSizePx",
        "gapPx",
        "normal",
        "drop"
      ],
      "properties": {
        "spinType": {
          "enum": [
            "normal",
            "drop"
          ]
        },
        "cellSizePx": {
          "type": "integer",
          "minimum": 1
        },
        "gapPx": {
          "type": "integer",
          "minimum": 0
        },
        "normal": {
          "type": "object",
          "required": [
            "speedPxPerSecond",
            "turboSpeedPxPerSecond",
            "stopDelayMs",
            "turboStopDelayMs",
            "bounceMs",
            "bouncePx"
          ],
          "properties": {
            "speedPxPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "turboSpeedPxPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "stopDelayMs": {
              "type": "integer",
              "minimum": 0
            },
            "turboStopDelayMs": {
              "type": "integer",
              "minimum": 0
            },
            "bounceMs": {
              "type": "integer",
              "minimum": 1
            },
            "bouncePx": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "drop": {
          "type": "object",
          "required": [
            "exit",
            "enter",
            "bounceMs",
            "bouncePx",
            "turboMultiplier"
          ],
          "properties": {
            "exit": {
              "$ref": "#/$defs/dropPhase"
            },
            "enter": {
              "$ref": "#/$defs/dropPhase"
            },
            "bounceMs": {
              "type": "integer",
              "minimum": 1
            },
            "bouncePx": {
              "type": "integer",
              "minimum": 0
            },
            "turboMultiplier": {
              "type": "number",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "demo": {
      "type": "object",
      "required": [
        "initialBalance",
        "capMultiplier",
        "buyPrices",
        "chancePrices",
        "scatterRates",
        "featureSpins",
        "retriggerSpins",
        "maxFeatureSpins",
        "chestMultipliers",
        "winTiers"
      ],
      "properties": {
        "initialBalance": {
          "type": "integer",
          "minimum": 0
        },
        "capMultiplier": {
          "type": "integer",
          "minimum": 1
        },
        "buyPrices": {
          "type": "object",
          "required": [
            "tavern",
            "drop"
          ],
          "properties": {
            "tavern": {
              "type": "integer",
              "minimum": 0
            },
            "drop": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "chancePrices": {
          "type": "object",
          "required": [
            "standard",
            "extra",
            "super"
          ],
          "properties": {
            "standard": {
              "type": "integer",
              "minimum": 0
            },
            "extra": {
              "type": "integer",
              "minimum": 0
            },
            "super": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "scatterRates": {
          "type": "object",
          "required": [
            "standard",
            "extra",
            "super"
          ],
          "properties": {
            "standard": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extra": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "super": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "featureSpins": {
          "type": "object",
          "required": [
            "tavern",
            "drop"
          ],
          "properties": {
            "tavern": {
              "type": "integer",
              "minimum": 0
            },
            "drop": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "retriggerSpins": {
          "type": "integer",
          "minimum": 0
        },
        "maxFeatureSpins": {
          "type": "integer",
          "minimum": 0
        },
        "chestMultipliers": {
          "type": "object",
          "required": [
            "tavern",
            "drop"
          ],
          "properties": {
            "tavern": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "drop": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "additionalProperties": false
        },
        "winTiers": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "label",
              "multiplier"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "multiplier": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "defaultBet": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dropPhase": {
      "type": "object",
      "required": [
        "fallMs",
        "reelStaggerMs",
        "rowStaggerMs",
        "holdMs"
      ],
      "properties": {
        "fallMs": {
          "type": "integer",
          "minimum": 1
        },
        "reelStaggerMs": {
          "type": "integer",
          "minimum": 0
        },
        "rowStaggerMs": {
          "type": "integer",
          "minimum": 0
        },
        "holdMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "required": [
        "id",
        "label",
        "glyph",
        "kind",
        "color",
        "pays"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "royal",
            "premium",
            "wild",
            "bonus"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "pays": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  }
}
